{
  "name": "solva",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-knowledge Proof of Reserves protocol on Stellar",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json}\"",
    "format:check": "node scripts/check-format.mjs",
    "comments:check": "node scripts/check-comments.mjs",
    "knip": "pnpm -r --if-present knip",
    "preflight": "./scripts/preflight.sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
