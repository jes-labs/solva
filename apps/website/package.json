{
  "name": "@solva/website",
  "version": "0.2.0",
  "private": true,
  "description": "Solva marketing website",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "cn:tables": "cn build --content \"src/**/*.{ts,tsx}\" --config cn.config.mjs --css src/app/globals.css -o src/lib/cn-tables.ts -q",
    "predev": "pnpm cn:tables",
    "prebuild": "pnpm cn:tables",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "knip": "knip",
    "build:cloudflare": "pnpm --filter \"@solva/website^...\" build && opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "smoke:worker": "../../scripts/worker-smoke.sh website"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@phosphor-icons/react": "2.1.10",
    "@solva/sdk-ts": "workspace:*",
    "@stellar/stellar-sdk": "16.0.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "gray-matter": "4.0.3",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.3",
    "next-mdx-remote": "6.0.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "6.14.0",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-boundaries": "7.3.0",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
